{
  "sourceLanguage": "uk",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth потрібен, щоб знайти пристрій Xiaomi та встановити циферблат."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is needed to find your Xiaomi device and install watch faces."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth нужен, чтобы найти устройство Xiaomi и установить циферблат."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб зберегти знімок циферблата у Фото."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To save a watch face screenshot to Photos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы сохранить снимок циферблата в Фото."
          }
        }
      }
    }
  },
  "version": "1.0"
}