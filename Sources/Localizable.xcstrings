    "Без ключа застосунок не зможе підключитися до браслета. Його можна знайти автоматично в даних Mi Fitness.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the key the app can't connect to the band. It can be found automatically in the Mi Fitness data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без ключа приложение не сможет подключиться к браслету. Его можно найти автоматически в данных Mi Fitness."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без ключа застосунок не зможе підключитися до браслета. Його можна знайти автоматично в даних Mi Fitness."
          }
        }
      }
    },
    "Браслет": {
      "extractionState": "manual",
      "localizations": {
        "en": {
