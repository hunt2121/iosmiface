    },
    "Браслет використовує протокол V1 (характеристики 0x51–0x55). Його ще не реалізовано.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The band uses protocol V1 (characteristics 0x51–0x55). It isn't supported yet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Браслет использует протокол V1 (характеристики 0x51–0x55). Он пока не реализован."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Браслет використовує протокол V1 (характеристики 0x51–0x55). Його ще не реалізовано."
          }
        }
      }
    },
