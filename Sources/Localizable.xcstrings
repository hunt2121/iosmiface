    "Текст малює сам браслет своїм шрифтом, тож на полотні він виглядає приблизно.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The band draws text with its own font, so on the canvas it looks approximate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст рисует сам браслет своим шрифтом, поэтому на холсте он выглядит приблизительно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст малює сам браслет своїм шрифтом, тож на полотні він виглядає приблизно."
          }
        }
      }
    },
