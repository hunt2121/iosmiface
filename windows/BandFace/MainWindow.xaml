<Window x:Class="BandFace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:creator="clr-namespace:BandFace.Creator"
        Title="BandFace" Width="1240" Height="800" MinWidth="1000" MinHeight="640"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" Icon="Assets/app.ico">
  <Window.Resources>
    <!-- Плитка налаштувань як у «Параметрах» Windows 11: уся ширина, підсвічування під мишею -->
    <Style x:Key="SettingRow" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="16,0" MinHeight="66">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource BtnHover}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="MinHeight" Value="66"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <!-- Однотонний значок налаштування (Segoe MDL2) -->
    <Style x:Key="SettingGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Width" Value="20"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/></Style>
    <Style x:Key="SettingDesc" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="GroupHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="2,14,0,8"/>
    </Style>
    <Style x:Key="NavGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Width" Value="20"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
    </Style>
    <Style x:Key="NavText" TargetType="TextBlock">
      <Setter Property="Margin" Value="14,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- Вміст вкладок; лівий відступ = ширина бічного меню (228 або 60 у редакторі) -->
    <Grid x:Name="ContentHost" Margin="228,0,0,0">
      <Grid x:Name="PagesHost" Margin="26,6,36,0">

        <!-- Циферблати -->
        <ScrollViewer x:Name="PageFaces" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,0,24">
            <TextBlock x:Name="TitleFaces" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,18"/>
            <!-- Немає ключа: як в iOS, кнопка веде в Налаштування → Ключ -->
            <Border x:Name="KeyNotice" Style="{StaticResource CardBox}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="KeyNoticeLabel" FontSize="13" Margin="0,0,0,12" Foreground="{DynamicResource Sub}"/>
                <Button x:Name="AddKeyBtn" Style="{StaticResource PrimaryBtn}" Height="34" Padding="18,0" HorizontalAlignment="Left" Click="AddKey_Click"/>
                <TextBlock x:Name="KeyNoticeText" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Sub}"/>
              </StackPanel>
            </Border>

            <!-- Пристрій: як в iOS — значок, назва моделі, червона кнопка «від'єднати» -->
            <Border Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock x:Name="BandLabel" FontSize="13" Margin="0,0,0,12" Foreground="{DynamicResource Sub}"/>
                <Grid x:Name="BandConnected" Visibility="Collapsed">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Viewbox Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Canvas Width="26" Height="26"><Path Data="{StaticResource BandGeometry}" Fill="{DynamicResource Accent}"/></Canvas>
                  </Viewbox>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="BandName" FontSize="16" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="BandStatus" FontSize="12" Foreground="{DynamicResource Sub}" Visibility="Collapsed"/>
                  </StackPanel>
                  <Button x:Name="DisconnectBtn" Grid.Column="2" Style="{StaticResource IconBtn}" Width="36" Height="36" BorderThickness="0" Background="Transparent" Click="Disconnect_Click">
                    <Viewbox Width="22" Height="22"><Canvas Width="30" Height="30"><Path Data="{StaticResource DisconnectGeometry}" Fill="{DynamicResource Err}"/></Canvas></Viewbox>
                  </Button>
                </Grid>
                <Grid x:Name="BandConnecting" Visibility="Collapsed">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <!-- індикатор: дуга, що обертається -->
                  <Path x:Name="Spinner" Width="20" Height="20" Margin="2,0,14,0" Stretch="None" Stroke="{DynamicResource Accent}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M 10,1.5 A 8.5,8.5 0 1 1 1.5,10" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                    <Path.RenderTransform><RotateTransform x:Name="SpinnerRotate"/></Path.RenderTransform>
                  </Path>
                  <TextBlock x:Name="ConnectingText" Grid.Column="1" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <Button x:Name="CancelConnectBtn" Grid.Column="2" Style="{StaticResource Btn}" Height="34" Padding="18,0" Click="CancelConnect_Click"/>
                </Grid>
                <StackPanel x:Name="BandIdle">
                  <TextBlock x:Name="BandNone" FontSize="16" Margin="0,0,0,10"/>
                  <Button x:Name="ScanBtn" Style="{StaticResource Btn}" Height="34" Padding="18,0" HorizontalAlignment="Left" Click="Scan_Click"/>
                  <StackPanel x:Name="DeviceList" Margin="0,10,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock x:Name="InstallLabel" FontSize="13" Margin="0,0,0,12" Foreground="{DynamicResource Sub}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <!-- Капсула як в iOS: сіре обведення 3 px, рівне закруглення, вміст обрізано по капсулі -->
                  <Border x:Name="Capsule" Width="102" Height="242" CornerRadius="51" Background="#7A7A7A" Padding="3">
                    <Grid x:Name="CapsuleInner" Width="96" Height="236" Background="Black">
                      <Grid.Clip><RectangleGeometry Rect="0,0,96,236" RadiusX="48" RadiusY="48"/></Grid.Clip>
                      <Viewbox x:Name="PreviewPlaceholder" Width="30" Height="30">
                        <Canvas Width="26" Height="26"><Path Data="{StaticResource BandGeometry}" Fill="#666666"/></Canvas>
                      </Viewbox>
                      <Image x:Name="PreviewImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock x:Name="FaceName" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FaceInfo" FontSize="12" Margin="0,4,0,2" Foreground="{DynamicResource Sub}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FaceFileName" FontSize="12" Foreground="{DynamicResource Sub}" TextTrimming="CharacterEllipsis"/>
                    <Grid Margin="0,18,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Button x:Name="PickBtn" Style="{StaticResource PrimaryBtn}" Height="40" Click="Pick_Click"/>
                      <Button x:Name="InstallBtn" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Height="40" Click="Install_Click"/>
                    </Grid>
                    <Grid Margin="0,20,0,0" MinHeight="34">
                      <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                        <ProgressBar x:Name="Bar" Minimum="0" Maximum="1"/>
                        <Grid Margin="0,6,0,0">
                          <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{DynamicResource Sub}"/>
                          <TextBlock x:Name="ProgressPercent" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource Sub}"/>
                        </Grid>
                      </StackPanel>
                      <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top"/>
                    </Grid>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Налаштування: як «Параметри» Windows 11 -->
        <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="0,0,0,24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock x:Name="TitleSettings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="DeviceSectionLabel" Style="{StaticResource GroupHeader}"/>
            <Button Style="{StaticResource SettingRow}" Click="OpenKey_Click">
              <DockPanel>
                <TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE192;"/>
                <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource Sub}"/>
                <TextBlock x:Name="KeyStateIcon" DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock x:Name="RowKeyText" Style="{StaticResource SettingTitle}"/>
                  <TextBlock x:Name="RowKeyDesc" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
              </DockPanel>
            </Button>
            <Button Style="{StaticResource SettingRow}" Click="OpenLog_Click">
              <DockPanel>
                <TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE8A5;"/>
                <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource Sub}"/>
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock x:Name="RowLogText" Style="{StaticResource SettingTitle}"/>
                  <TextBlock x:Name="RowLogDesc" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
              </DockPanel>
            </Button>

            <!-- Сповіщення на пристрій -->
            <TextBlock x:Name="NotifySectionLabel" Style="{StaticResource GroupHeader}"/>
            <Border Style="{StaticResource SettingCard}">
              <DockPanel>
                <TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE8E1;"/>
                <CheckBox x:Name="WelcomeSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Welcome_Click"/>
                <StackPanel VerticalAlignment="Center" Margin="0,12,16,12">
                  <TextBlock x:Name="RowWelcomeText" Style="{StaticResource SettingTitle}"/>
                  <TextBlock x:Name="RowWelcomeDesc" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE8BD;"/>
                  <CheckBox x:Name="ForwardSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Forward_Click"/>
                  <StackPanel VerticalAlignment="Center" Margin="0,12,16,12">
                    <TextBlock x:Name="RowForwardText" Style="{StaticResource SettingTitle}"/>
                    <TextBlock x:Name="RowForwardDesc" Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
                <StackPanel x:Name="ForwardApps" Margin="44,0,0,12" Orientation="Horizontal">
                  <CheckBox x:Name="AppWa" Content="WhatsApp" Margin="0,0,20,0" VerticalAlignment="Center" Click="ForwardApps_Click"/>
                  <CheckBox x:Name="AppTg" Content="Telegram" Margin="0,0,20,0" VerticalAlignment="Center" Click="ForwardApps_Click"/>
                  <CheckBox x:Name="AppOther" Margin="0,0,20,0" VerticalAlignment="Center" Click="ForwardApps_Click"/>
                  <Button x:Name="TestNotifyBtn" Style="{StaticResource Btn}" Click="TestNotify_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock x:Name="AppSectionLabel" Style="{StaticResource GroupHeader}"/>
            <Border Style="{StaticResource SettingCard}">
              <DockPanel>
                <TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE790;"/>
                <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Width="200" VerticalAlignment="Center" SelectionChanged="Theme_Changed"/>
                <StackPanel VerticalAlignment="Center" Margin="0,12,16,12">
                  <TextBlock x:Name="RowThemeText" Style="{StaticResource SettingTitle}"/>
                  <TextBlock x:Name="RowThemeDesc" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
              <DockPanel>
                <TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE774;"/>
                <ComboBox x:Name="LangBox" DockPanel.Dock="Right" Width="200" VerticalAlignment="Center" SelectionChanged="Lang_Changed"/>
                <StackPanel VerticalAlignment="Center" Margin="0,12,16,12">
                  <TextBlock x:Name="RowLangText" Style="{StaticResource SettingTitle}"/>
                  <TextBlock x:Name="RowLangDesc" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
              <DockPanel>
                <TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE946;"/>
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock x:Name="RowVersionText" Style="{StaticResource SettingTitle}"/>
                  <TextBlock x:Name="VersionValue" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Налаштування → Ключ -->
        <ScrollViewer x:Name="PageKey" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <Button x:Name="KeyBackBtn" Style="{StaticResource IconBtn}" Content="&#xE72B;" VerticalAlignment="Center" Click="SettingsBack_Click"/>
              <TextBlock x:Name="TitleKey" FontSize="28" FontWeight="SemiBold" Margin="14,0,0,0"/>
            </StackPanel>
            <Border Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock x:Name="CloudLabel" FontSize="13" Margin="0,0,0,12" Foreground="{DynamicResource Sub}"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="CloudBtn" Style="{StaticResource Btn}" Height="34" Padding="18,0" Click="Cloud_Click"/>
                  <Button x:Name="CloudCancelBtn" Style="{StaticResource Btn}" Height="34" Padding="18,0" Margin="10,0,0,0" Visibility="Collapsed" Click="CloudCancel_Click"/>
                </StackPanel>
                <Image x:Name="QrImage" Width="220" Height="220" HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock x:Name="CloudStatus" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource Sub}"/>
                <StackPanel x:Name="CloudDevices" Margin="0,8,0,0"/>
                <TextBlock x:Name="CloudNote" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Sub}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock x:Name="KeyLabel" FontSize="13" Margin="0,0,0,12" Foreground="{DynamicResource Sub}"/>
                <TextBox x:Name="KeyBox" Height="36" FontFamily="Consolas" FontSize="14" TextChanged="KeyBox_TextChanged"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button x:Name="PasteBtn" Style="{StaticResource Btn}" Height="34" Padding="18,0" Click="Paste_Click"/>
                  <Button x:Name="FromFileBtn" Style="{StaticResource Btn}" Height="34" Padding="18,0" Margin="10,0,0,0" Click="FromFile_Click"/>
                  <TextBlock x:Name="KeyMessage" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Ok}"/>
                </StackPanel>
                <TextBlock x:Name="KeyNote" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Sub}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Налаштування → Журнал -->
        <ScrollViewer x:Name="PageLog" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <Button x:Name="LogBackBtn" Style="{StaticResource IconBtn}" Content="&#xE72B;" VerticalAlignment="Center" Click="SettingsBack_Click"/>
              <TextBlock x:Name="TitleLog" FontSize="28" FontWeight="SemiBold" Margin="14,0,0,0"/>
            </StackPanel>
            <Border Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock x:Name="ActivityLabel" FontSize="13" Margin="0,0,0,12" Foreground="{DynamicResource Sub}"/>
                <Grid>
                  <TextBlock x:Name="DevLabel" FontSize="14" VerticalAlignment="Center"/>
                  <CheckBox x:Name="DevSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Dev_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,14">
                  <Button x:Name="CopyBtn" Style="{StaticResource Btn}" Height="34" Padding="18,0" Click="Copy_Click"/>
                  <Button x:Name="ClearBtn" Style="{StaticResource Btn}" Height="34" Padding="18,0" Margin="10,0,0,0" Foreground="{DynamicResource Err}" Click="Clear_Click"/>
                  <Button x:Name="LogFileBtn" Style="{StaticResource Btn}" Height="34" Padding="18,0" Margin="10,0,0,0" Click="LogFile_Click"/>
                </StackPanel>
                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Sub}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Редактор: свої відступи, на всю ширину вкладки -->
      <creator:CreatorView x:Name="EditorTab" Visibility="Collapsed"/>
    </Grid>

    <!-- Затемнення під розгорнутим меню в редакторі: клік — згорнути -->
    <Border x:Name="Shade" Background="#40000000" Visibility="Collapsed" MouseLeftButtonDown="Shade_MouseDown"/>

    <!-- Бічне меню: 228 px; у редакторі — смуга іконок 60 px, «☰» розгортає поверх -->
    <Border x:Name="Sidebar" Width="228" HorizontalAlignment="Left" Background="{DynamicResource Bg}">
      <DockPanel Margin="10,8">
        <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" FontSize="12" Margin="12,0,0,6" Foreground="{DynamicResource Sub}"/>
        <StackPanel>
          <Button x:Name="MenuBtn" Style="{StaticResource IconBtn}" Content="&#xE700;" Width="40" Height="36" BorderThickness="0" Background="Transparent"
                  HorizontalAlignment="Left" Margin="0,0,0,6" Visibility="Collapsed" Click="Menu_Click"/>
          <RadioButton x:Name="NavFaces" Style="{StaticResource Nav}" IsChecked="True" GroupName="nav" Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="20" Height="20"><Canvas Width="26" Height="26">
                <Path Data="{StaticResource BandGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              </Canvas></Viewbox>
              <TextBlock x:Name="NavFacesText" Style="{StaticResource NavText}"/>
            </StackPanel>
          </RadioButton>
          <!-- Магазин: поки сірий і неактивний -->
          <RadioButton x:Name="NavStore" Style="{StaticResource Nav}" GroupName="nav" IsEnabled="False" ToolTipService.ShowOnDisabled="True">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE719;"/>
              <TextBlock x:Name="NavStoreText" Style="{StaticResource NavText}"/>
              <Border x:Name="StoreChip" Background="{DynamicResource ChipBg}" CornerRadius="9" Padding="7,0" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="StoreChipText" FontSize="11" Foreground="{DynamicResource Sub}"/>
              </Border>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavEditor" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE70F;"/>
              <TextBlock x:Name="NavEditorText" Style="{StaticResource NavText}"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal">
              <Grid>
                <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;"/>
                <!-- немає ключа — червоний «!» на значку, як в iOS -->
                <Border x:Name="KeyBadge" Width="14" Height="14" CornerRadius="7" Background="{DynamicResource Err}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Visibility="Collapsed">
                  <TextBlock Text="!" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                </Border>
              </Grid>
              <TextBlock x:Name="NavSettingsText" Style="{StaticResource NavText}"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Підказка під час перетягування файла у вікно -->
    <Border x:Name="DropHint" Background="#99000000" Visibility="Collapsed" IsHitTestVisible="False">
      <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="DropText" FontSize="16" FontWeight="SemiBold"/>
      </Border>
    </Border>
  </Grid>
</Window>
