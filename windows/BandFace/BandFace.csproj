<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- вибір теки в редакторі -->
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>BandFace</AssemblyName>
    <RootNamespace>BandFace</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
    <!-- редактор XML у редакторі циферблатів: підсвітка, номери рядків (MIT) -->
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <Resource Include="Assets\app.ico" />
    <!-- компілятор циферблатів (спільний з тестами FaceKit.Tests) -->
    <Compile Include="..\FaceKit\*.cs" Link="FaceKit\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
