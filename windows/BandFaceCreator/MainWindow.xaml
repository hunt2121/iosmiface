<Window x:Class="BandFace.Creator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BandFace.Creator"
        Title="BandFace Creator" Width="1320" Height="840" MinWidth="1100" MinHeight="680"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" Icon="Assets/app.ico">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <DockPanel Margin="10,8">
      <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" FontSize="12" Margin="12,0,0,6" Foreground="{DynamicResource Sub}"/>
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="12,6,0,16">
          <Image Source="Assets/app.ico" Width="24" Height="24"/>
          <TextBlock Text="BandFace Creator" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        <RadioButton x:Name="NavFaces" Style="{StaticResource Nav}" IsChecked="True" GroupName="nav" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock x:Name="NavFacesText" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavEditor" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked" IsEnabled="False">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock x:Name="NavEditorText" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavFonts" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock x:Name="NavFontsText" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14"/>
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Column="1">
      <!-- Циферблати (проєкти) -->
      <ScrollViewer x:Name="PageFaces" VerticalScrollBarVisibility="Auto" Margin="26,6,26,0">
        <StackPanel Margin="0,0,0,24">
          <Grid Margin="0,0,0,18">
            <TextBlock x:Name="TitleFaces" FontSize="28" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="OpenFolderBtn" Style="{StaticResource Btn}" Click="OpenFolder_Click"/>
              <Button x:Name="OpenBinBtn" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="OpenBin_Click"/>
              <Button x:Name="NewBtn" Style="{StaticResource PrimaryBtn}" Margin="10,0,0,0" Click="New_Click"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="FacesHint" FontSize="12" Foreground="{DynamicResource Sub}" Margin="0,0,0,14" TextWrapping="Wrap"/>
          <WrapPanel x:Name="ProjectsPanel"/>
          <Border x:Name="EmptyCard" Style="{StaticResource CardBox}" Visibility="Collapsed" Padding="24">
            <StackPanel>
              <TextBlock x:Name="EmptyTitle" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock x:Name="EmptyText" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Sub}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Редактор -->
      <local:EditorView x:Name="Editor" Visibility="Collapsed"/>

      <!-- Шрифти -->
      <ScrollViewer x:Name="PageFonts" VerticalScrollBarVisibility="Auto" Margin="26,6,26,0" Visibility="Collapsed">
        <StackPanel Margin="0,0,0,24" MaxWidth="900" HorizontalAlignment="Left">
          <Grid Margin="0,0,0,18">
            <TextBlock x:Name="TitleFonts" FontSize="28" FontWeight="SemiBold"/>
            <Button x:Name="AddFontBtn" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddFont_Click"/>
          </Grid>
          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <TextBlock x:Name="FontsLabel" FontSize="13" Margin="0,0,0,8" Foreground="{DynamicResource Sub}"/>
              <TextBlock x:Name="FontsNote" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Sub}" Margin="0,0,0,12"/>
              <StackPanel x:Name="UserFonts"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <TextBlock x:Name="SysFontsLabel" FontSize="13" Margin="0,0,0,8" Foreground="{DynamicResource Sub}"/>
              <TextBox x:Name="FontSearch" Margin="0,0,0,10" TextChanged="FontSearch_TextChanged"/>
              <StackPanel x:Name="SysFonts"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Підказка під час перетягування файла у вікно -->
    <Border x:Name="DropHint" Grid.ColumnSpan="2" Background="#99000000" Visibility="Collapsed" IsHitTestVisible="False">
      <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="DropText" FontSize="16" FontWeight="SemiBold"/>
      </Border>
    </Border>
  </Grid>
</Window>
