<Project Sdk="Microsoft.NET.Sdk">
  <!-- BandFace Creator: редактор циферблатів Xiaomi Smart Band 10 / 11 (WPF, .NET Framework 4.8 — вбудований у Windows 10/11) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>BandFaceCreator</AssemblyName>
    <RootNamespace>BandFace.Creator</RootNamespace>
    <Product>BandFace Creator</Product>
    <AssemblyTitle>BandFace Creator</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- збірка й на Linux (перевірка компіляції без Windows) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <!-- компілятор циферблатів — спільний код (пізніше його підключить і BandFace для Windows) -->
    <Compile Include="..\FaceKit\*.cs" Link="FaceKit\%(Filename)%(Extension)" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
